<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description"
        content="Book a DPIA consultation with ACE Data Protection Consulting for practical, independent support on privacy risk and regulatory compliance.">
    <meta name="author" content="ACE Data Protection Consulting">
    <meta name="theme-color" content="#4259a9">
    <title>Book a DPIA Consultation | ACE Data Protection Consulting</title>
    <link rel="shortcut icon" href="../images/favicon.png" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="../css/dpia-home.css">
    <link rel="stylesheet" href="./css/consultation.css">
    <link rel="stylesheet" href="./css/consultation-enhancements.css">
    <link rel="stylesheet" href="../css/ace-footer.css">

    <script src="../js/ace-dashboard-api.js"></script>
    <script src="../consultation/js/consultation.js"></script>
</head>

<body class="consultation-page" data-footer-context="consultation">
    <a class="skip-link" href="#consultation-form">Skip to consultation form</a>

    <div class="topbar">
        <div class="shell topbar-inner">
            <span>ACE Data Protection Consulting</span>
            <span>Practical accountability for complex processing</span>
        </div>
    </div>

    <header class="site-header" data-header>
        <div class="shell nav-wrap">
            <a class="brand" href="../../index.html" aria-label="ACE Data Protection Consulting home">
                <img src="/images/logo.png" alt="ACE Data Protection Consulting" width="156" height="70">
            </a>
            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
                <span></span><span></span><span></span>
                <span class="sr-only">Open navigation menu</span>
            </button>
            <nav class="site-menu" id="site-menu" aria-label="Main navigation" data-menu>
                <a href="../index.html#hero-actual">Learn</a>
                <a href="../index.html#toolkit-actual">Implement</a>
                <a href="../index.html#training-actual">Build Capability</a>
                <a href="../index.html#consultation-actual">Get Support</a>
                <a class="nav-cta" href="#consultation-form">Book a Consultation <span aria-hidden="true">↗</span></a>
            </nav>
        </div>
    </header>

    <main>
        <div id="consultation-skeleton" class="skel-consultation-page" aria-hidden="true">
            <section class="skel-consultation-hero">
                <div class="shell skel-consultation-hero-grid">
                    <div>
                        <div class="skel-shimmer skel-consultation-eyebrow"></div>
                        <div class="skel-shimmer skel-consultation-title"></div>
                        <div class="skel-shimmer skel-consultation-subtitle"></div>
                        <div class="skel-shimmer skel-consultation-description"></div>
                        <div class="skel-shimmer skel-consultation-description skel-consultation-description-short">
                        </div>
                        <div class="skel-shimmer skel-consultation-button"></div>
                    </div>
                    <div class="skel-shimmer skel-consultation-lifecycle">
                        <div class="skel-consultation-lifecycle-heading">
                            <div class="skel-shimmer"></div>
                            <div class="skel-shimmer"></div>
                        </div>
                        <div class="skel-consultation-lifecycle-steps">
                            <div class="skel-shimmer"></div>
                            <div class="skel-shimmer"></div>
                            <div class="skel-shimmer"></div>
                            <div class="skel-shimmer"></div>
                            <div class="skel-shimmer"></div>
                        </div>
                        <div class="skel-shimmer skel-consultation-lifecycle-caption"></div>
                    </div>
                </div>
            </section>
            <section class="skel-consultation-services">
                <div class="shell">
                    <div class="skel-shimmer skel-consultation-label"></div>
                    <div class="skel-shimmer skel-consultation-heading"></div>
                    <div class="skel-shimmer skel-consultation-copy"></div>
                    <div class="skel-consultation-service-grid">
                        <div class="skel-shimmer"></div>
                        <div class="skel-shimmer"></div>
                        <div class="skel-shimmer"></div>
                        <div class="skel-shimmer"></div>
                        <div class="skel-shimmer"></div>
                        <div class="skel-shimmer"></div>
                        <div class="skel-shimmer"></div>
                    </div>
                </div>
            </section>
            <section class="skel-consultation-form">
                <div class="shell">
                    <div class="skel-shimmer skel-consultation-label"></div>
                    <div class="skel-shimmer skel-consultation-heading"></div>
                    <div class="skel-shimmer skel-consultation-copy"></div>
                    <div class="skel-consultation-form-layout">
                        <div class="skel-consultation-form-main">
                            <div class="skel-consultation-fieldset">
                                <div class="skel-shimmer skel-consultation-legend"></div>
                                <div class="skel-consultation-input-grid">
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                </div>
                            </div>
                            <div class="skel-consultation-fieldset">
                                <div class="skel-shimmer skel-consultation-legend"></div>
                                <div class="skel-consultation-choice-grid">
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                    <div class="skel-shimmer"></div>
                                </div>
                            </div>
                            <div class="skel-consultation-fieldset skel-consultation-tall">
                                <div class="skel-shimmer skel-consultation-legend"></div>
                                <div class="skel-shimmer skel-consultation-textarea"></div>
                            </div>
                        </div>
                        <div class="skel-consultation-aside">
                            <div class="skel-shimmer skel-consultation-aside-card"></div>

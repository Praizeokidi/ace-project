<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description"
    content="DPIA Made Easy – Professional Edition: a practical handbook, workbook and training guide for implementing Data Privacy Impact Assessments under the Nigeria Data Protection Act.">
  <meta name="author" content="ACE Data Protection Consulting">
  <meta name="theme-color" content="#4259A9">
  <title>DPIA Made Easy – Professional Edition | ACE Data Protection Consulting</title>
  <link rel="shortcut icon" href="../images/favicon.png" type="image/x-icon">
  <link rel="icon" href="../images/favicon.png" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="css/dpia-home.css">
  <link rel="stylesheet" href="css/ace-footer.css">
  <link rel="stylesheet" href="css/glassmorph-blue.css">
  <link rel="stylesheet" href="css/ebook-production.css">



  <!-- LUXURY BRANDED WORKBOOK SECTION START -->
  <style>
    /* Ensure actual sections are hidden immediately on page start */
    #hero-actual,
    #intro-actual,
    #workbook-actual,
    #audience-actual,
    #benefits-actual,
    #toolkit-actual,
    #review-actual,
    #completion-actual,
    #training-actual,
    #combined-actual,
    #consultation-actual,
    #ecosystem-actual,
    #priority-actual,
    #faq-actual,
    #final-actual,
    #about-author-actual,
    #audio-actual {
      display: none;
      opacity: 0;
    }

    /* --- HERO SKELETON STYLES --- */
    .hero-skeleton-wrapper {
      position: relative;
      background: #0f172a;
      /* Match your hero background color */
      padding: 100px 0;
      overflow: hidden;
    }

    .skel-shimmer {
      background: linear-gradient(90deg,
          rgba(66, 89, 169, 0.05) 0%,
          rgba(66, 89, 169, 0.15) 50%,
          rgba(66, 89, 169, 0.05) 100%);
      background-size: 200% 100%;
      animation: skel-load 1.8s infinite ease-in-out;
      border-radius: 4px;
    }

    @keyframes skel-load {
      0% {
        background-position: 200% 0;
      }

      100% {
        background-position: -200% 0;
      }
    }

    /* Shapes to match your Hero */
    .skel-eyebrow {
      width: 200px;
      height: 12px;
      border-radius: 20px;
      margin-bottom: 24px;
    }

    .skel-title {
      width: 85%;
      height: 50px;
      margin-bottom: 20px;
    }

    .skel-subtitle {
      width: 60%;
      height: 24px;
      margin-bottom: 20px;
    }

    .skel-desc {
      width: 95%;
      height: 16px;
      margin-bottom: 10px;
    }

    .skel-btn {
      width: 160px;
      height: 48px;
      border-radius: 50px;
      display: inline-block;
      margin-right: 15px;
    }

    .skel-book {
      width: 320px;
      height: 480px;
      border-radius: 12px;
      margin: 0 auto;
    }


    /* --- INTRO SECTION SKELETON SHAPES --- */
    .skel-intro-wrapper {
      background: #fffdf9;
      /* Match your section-cream color */
      padding: 80px 0;
    }

    .skel-label-box {
      width: 120px;
      height: 14px;
      margin-bottom: 10px;
    }

    .skel-intro-eyebrow {
      width: 250px;
      height: 12px;
      margin-bottom: 20px;
    }

    .skel-intro-h2 {
      width: 90%;
      height: 40px;
      margin-bottom: 30px;
    }

    .skel-text-line {
      width: 100%;
      height: 14px;
      margin-bottom: 12px;
    }

    .skel-blockquote {
      width: 100%;
      height: 80px;
      margin: 20px 0;
      border-left: 4px solid rgba(66, 89, 169, 0.1);
      background: rgba(66, 89, 169, 0.02);
    }


    /* --- WORKBOOK SECTION SKELETON --- */
    .skel-workbook-wrapper {
      background: #f8faff;
      /* Match your section-light color */
      padding: 100px 0;
    }

    .skel-card-elite {
      background: #ffffff;
      border: 1px solid rgba(66, 89, 169, 0.08);
      border-radius: 16px;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      height: 80px;
      /* Match your actual card height */
    }

    .skel-spotlight-elite {
      grid-column: 1 / -1;
      height: 100px;
      background: rgba(66, 89, 169, 0.05);
      border-radius: 20px;
      margin-top: 1rem;
    }

    .skel-icon-box {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      flex-shrink: 0;
    }

    .skel-card-title {
      width: 70%;
      height: 16px;
      border-radius: 4px;
    }

    /* --- AUDIENCE SECTION SKELETON --- */
    .skel-audience-wrapper {
      background: #fffdf9;
      /* Match your section-cream color */
      padding: 80px 0;
    }

    .skel-audience-card {
      background: #ffffff;
      border: 1px solid rgba(66, 89, 169, 0.08);
      border-radius: 20px;
      padding: 2.5rem 2rem;
      height: 220px;
      /* Match your actual card height */
    }

    .skel-audience-wide {
      grid-column: 1 / -1;
      height: 180px;
    }

    .skel-card-num {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      margin-bottom: 1.5rem;
    }

    .skel-card-h3 {
      width: 70%;
      height: 20px;
      margin-bottom: 1rem;
    }

    .skel-card-p {
      width: 100%;
      height: 14px;
      margin-bottom: 8px;
    }



    /* --- BENEFITS SECTION SKELETON (DARK THEME) --- */
    .skel-benefits-wrapper {
      background: #0f172a;
      /* Match your section-dark color */
      padding: 100px 0;
    }

    .skel-benefit-block {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(66, 89, 169, 0.15);
      border-radius: 16px;
      padding: 2rem;
      height: 200px;
      /* Match your actual block height */
    }

    .skel-benefit-index {
      width: 30px;
      height: 18px;
      margin-bottom: 1.5rem;
      opacity: 0.5;
    }

    .skel-benefit-h3 {
      width: 80%;
      height: 22px;
      margin-bottom: 1rem;
    }

    .skel-benefit-p {
      width: 100%;
      height: 14px;
      margin-bottom: 8px;
      opacity: 0.7;
    }

    /* Darker Shimmer for Dark Backgrounds */
    .skel-benefits-wrapper .skel-shimmer {
      background: linear-gradient(90deg,
          rgba(66, 89, 169, 0.1) 0%,
          rgba(66, 89, 169, 0.25) 50%,
          rgba(66, 89, 169, 0.1) 100%);
      background-size: 200% 100%;
    }


    .skel-audio-wrapper {
      background: #0f172a;
      padding: 100px 0;
    }

    .skel-audio-player {
      flex: 0 0 340px;
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 28px;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 6px;
    }

    .skel-audio-bars {
      flex: 1;
      display: flex;
      align-items: flex-end;
      gap: 4px;
      height: 40px;
    }

    .skel-audio-bars span {
      flex: 1;
      height: 60%;
      border-radius: 2px;
      background: rgba(210, 169, 93, 0.15);
    }

    .skel-audio-bars span:nth-child(2n) {
      height: 90%;
    }

    .skel-audio-bars span:nth-child(3n) {
      height: 40%;
    }


    /* --- TRAINING SECTION SKELETON --- */
    .skel-training-wrapper {
      background: #fffdf9;
      /* Match your section-cream color */
      padding: 100px 0;
    }

    .skel-training-types {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin: 25px 0;
    }

    .skel-training-tag {
      width: 180px;
      height: 36px;
      border-radius: 6px;
      background: rgba(66, 89, 169, 0.05);
    }

    .skel-lead-text {
      width: 100%;
      height: 24px;
      margin-bottom: 12px;
      border-radius: 4px;
    }



    /* --- CONSULTATION SECTION SKELETON (NAVY THEME) --- */
    .skel-consultation-wrapper {
      background: #0f172a;
      /* Match your section-navy color */
      padding: 100px 0;
    }

    .skel-consultation-list {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 30px;
    }

    .skel-consultation-tag {
      width: 200px;
      height: 32px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.05);
    }

    .skel-white-btn {
      width: 220px;
      height: 52px;
      border-radius: 50px;
      background: #ffffff;
      opacity: 0.2;
    }


    /* --- ECOSYSTEM SECTION SKELETON --- */
    .skel-ecosystem-wrapper {
      background: #f8faff;
      /* Match your section-light color */
      padding: 100px 0;
    }

    .skel-flow-line {
      width: 300px;
      height: 12px;
      margin: 0 auto;
      border-radius: 20px;
      opacity: 0.4;
    }

    .skel-series-card {
      background: #ffffff;
      border: 1px solid rgba(66, 89, 169, 0.08);
      border-radius: 16px;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1.25rem;
      height: 100px;
    }

    .skel-series-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: rgba(66, 89, 169, 0.1);
      flex-shrink: 0;
    }

    .skel-series-h3 {
      width: 80%;
      height: 16px;
      margin-bottom: 8px;
    }

    .skel-series-p {
      width: 50%;
      height: 12px;
      opacity: 0.6;
    }


    /* --- PRIORITY SECTION SKELETON (GOLD THEME) --- */
    .skel-priority-wrapper {
      background: #d4af37;
      /* Match your section-gold color */
      padding: 80px 0;
    }

    .skel-priority-benefits {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 20px;
    }

    .skel-benefit-tag {
      width: 120px;
      height: 28px;
      border-radius: 4px;
      background: rgba(15, 23, 42, 0.1);
      /* Navy at low opacity */
    }

    .skel-form-box {
      background: #ffffff;
      border-radius: 12px;
      padding: 2.5rem;
      width: 100%;
      max-width: 450px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    .skel-input-line {
      width: 100%;
      height: 45px;
      border-radius: 6px;
      margin-bottom: 20px;
      background: #f1f5f9;
    }

    .skel-label-line {
      width: 40%;
      height: 12px;
      margin-bottom: 8px;
    }


    /* --- FAQ SECTION SKELETON --- */
    .skel-faq-wrapper {
      background: #fffdf9;
      /* Match your section-cream color */
      padding: 80px 0;
    }

    .skel-faq-list {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .skel-faq-item {
      width: 100%;
      height: 56px;
      /* Match your summary height */
      background: #ffffff;
      border: 1px solid rgba(66, 89, 169, 0.08);
      border-radius: 8px;
      display: flex;
      align-items: center;
      padding: 0 20px;
    }

    .skel-faq-line {
      width: 70%;
      height: 14px;
      border-radius: 4px;
    }


    /* --- FINAL BANNER SECTION SKELETON (DARK THEME) --- */
    .skel-final-wrapper {
      background: #0f172a;
      /* Match your section-dark color */
      padding: 80px 0;
    }

    .skel-final-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 40px;
    }

    .skel-final-btn {
      width: 180px;
      height: 50px;
      border-radius: 50px;
      margin-left: 15px;
    }

    @media (max-width: 768px) {
      .skel-final-inner {
        flex-direction: column;
        text-align: center;
      }

      .skel-final-btn {
        margin: 10px 0;
      }
    }

    /* The ebook page already defines .skel-shimmer and @keyframes skel-load. */
    .skel-author-wrapper {
      overflow: hidden;
      padding: 0 0;
      background: #eef1fb;
    }

    .skel-author-intro {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-bottom: 60px;
    }

    .skel-author-eyebrow {
      width: 210px;
      height: 12px;
      border-radius: 20px;
    }

    .skel-author-rule {
      width: 86px;
      height: 1px;
    }

    .skel-author-grid {
      display: grid;
      grid-template-columns: minmax(280px, 0.76fr) minmax(0, 1.24fr);
      align-items: start;
      gap: 80px;
    }

    .skel-author-visual {
      width: 100%;
      max-width: 430px;
    }

    .skel-author-portrait {
      position: relative;
      display: flex;
      min-height: 500px;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      border-radius: 2px;
      background-color: rgba(66, 89, 169, 0.12);
    }

    .skel-author-ring {
      position: absolute;
      width: 350px;
      height: 350px;
      border: 1px solid rgba(66, 89, 169, 0.16);
      border-radius: 50%;
    }

    .skel-author-initials {
      position: relative;
      z-index: 1;
      width: 150px;
      height: 78px;
    }

    .skel-author-portrait-label {
      position: absolute;
      right: 22px;
      bottom: 20px;
      width: 92px;
      height: 9px;
    }

    .skel-author-caption {
      display: flex;
      gap: 14px;
      margin-top: 19px;
    }

    .skel-author-caption-number {
      width: 18px;
      height: 10px;
      flex: 0 0 18px;
      margin-top: 3px;
    }

    .skel-author-caption-line {
      width: 265px;
      height: 10px;
      margin-bottom: 8px;
    }

    .skel-author-caption-line-short {
      width: 180px;
    }

    .skel-author-copy {
      width: 100%;
      max-width: 700px;
    }

    .skel-author-title {
      width: min(420px, 80%);
      height: 68px;
      margin-bottom: 22px;
    }

    .skel-author-lead {
      width: min(520px, 92%);
      height: 18px;
      margin-bottom: 9px;
    }

    .skel-author-lead-short {
      width: 64%;
      margin-bottom: 32px;
    }

    .skel-author-identity {
      padding: 22px 0 20px;
      border-top: 1px solid rgba(66, 89, 169, 0.16);
      border-bottom: 1px solid rgba(66, 89, 169, 0.16);
    }

    .skel-author-name {
      width: 270px;
      height: 21px;
      margin-bottom: 10px;
    }

    .skel-author-role {
      width: 390px;
      max-width: 90%;
      height: 12px;
    }

    .skel-author-credentials {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      margin: 28px 0 32px;
      background: rgba(66, 89, 169, 0.16);
    }

    .skel-author-credential {
      min-height: 86px;
      background-color: rgba(66, 89, 169, 0.08);
    }

    .skel-author-bio-line {
      width: 100%;
      height: 14px;
      margin-bottom: 10px;
    }

    .skel-author-bio-line-short {
      width: 72%;
      margin-bottom: 22px;
    }

    .skel-author-bio-line-medium {
      width: 84%;
    }

    .skel-author-quote {
      width: 100%;
      height: 86px;
      margin-top: 34px;
      border-left: 4px solid rgba(66, 89, 169, 0.22);
      background-color: rgba(66, 89, 169, 0.1);
    }

    @media (max-width: 800px) {
      .skel-author-wrapper {
        padding: 80px 0;
      }

      .skel-author-grid {
        grid-template-columns: 1fr;
        gap: 52px;
      }

      .skel-author-visual {
        width: min(100%, 430px);
        margin: 0 auto;
      }

      .skel-author-copy {
        max-width: none;
      }
    }

    @media (max-width: 560px) {
      .skel-author-intro {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 38px;
      }

      .skel-author-rule {
        width: 72px;
      }

      .skel-author-portrait {
        min-height: 390px;
      }

      .skel-author-ring {
        width: 285px;
        height: 285px;
      }

      .skel-author-credentials {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .skel-author-wrapper .skel-shimmer {
        animation: none;
      }
    }


    /* Premium editorial author section — uses the ebook page’s existing ACE tokens. */
    .author-editorial {
      --author-blue: #4259a9;
      --author-blue-light: #eef1fb;
      --author-blue-soft: #dfe5f7;
      --author-blue-mid: #7182c1;
      --author-blue-dark: #263875;
      --author-blue-deep: #102d4d;
      position: relative;
      overflow: hidden;
      padding: clamp(56px, 6vw, 100px) clamp(20px, 4vw, 48px);
      background: var(--cream);
    }

    .author-editorial__ornament {
      position: absolute;
      top: 0;
      right: -180px;
      width: 520px;
      height: 520px;
      border: 1px solid rgba(210, 169, 93, 0.16);
      border-radius: 50%;
      pointer-events: none;
    }

    .author-editorial__ornament::after {
      position: absolute;
      top: 38px;
      right: 38px;
      width: 442px;
      height: 442px;
      border: 1px solid rgba(210, 169, 93, 0.1);
      border-radius: 50%;
      content: "";
    }

    .author-editorial__intro {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-bottom: clamp(38px, 5vw, 68px);
    }

    .author-editorial__eyebrow {
      margin: 0;
      color: var(--gold-deep);
      white-space: nowrap;
    }

    .author-editorial__rule {
      display: block;
      width: min(180px, 20vw);
      height: 1px;
      background: var(--gold);
    }

    .author-editorial__grid {
      display: grid;
      grid-template-columns: minmax(280px, 0.76fr) minmax(0, 1.24fr);
      align-items: start;
      gap: clamp(52px, 8vw, 120px);
    }

    .author-editorial__portrait-column {
      position: relative;
      z-index: 1;
      max-width: 430px;
    }

    .author-editorial__portrait {
      position: relative;
      padding: 12px;
      background: var(--gold);
      box-shadow: 0 24px 60px rgba(16, 45, 77, 0.16);
    }

    .author-editorial__portrait::before {
      position: absolute;
      top: -9px;
      left: -9px;
      width: 76px;
      height: 76px;
      border-top: 1px solid var(--gold-deep);
      border-left: 1px solid var(--gold-deep);
      content: "";
    }

    .author-editorial__portrait-inner {
      position: relative;
      display: flex;
      min-height: 500px;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background:
        radial-gradient(circle at 50% 40%, rgba(66, 89, 169, 0.9), transparent 48%),
        linear-gradient(145deg, var(--blue), var(--navy-deep));
    }

    .author-editorial__portrait-image {
      position: absolute;
      inset: 0;
      z-index: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    .author-editorial__initials {
      position: relative;
      z-index: 1;
      color: var(--gold);
      font-family: var(--serif);
      font-size: clamp(4.3rem, 8vw, 6.8rem);
      letter-spacing: 0.08em;
      line-height: 1;
    }

    .author-editorial__portrait-label {
      position: absolute;
      right: 22px;
      bottom: 20px;
      z-index: 1;
      color: rgba(255, 255, 255, 0.64);
      font-size: 9px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .author-editorial__caption {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-top: 19px;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.65;
    }

    .author-editorial__caption-number {
      color: var(--gold-deep);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.1em;
    }

    .author-editorial__content {
      position: relative;
      z-index: 1;
      max-width: 700px;
    }

    .author-editorial h2 {
      margin: 0;
      color: var(--navy);
      font-family: var(--serif);
      font-size: clamp(3rem, 6vw, 5.4rem);
      font-weight: 400;
      letter-spacing: -0.05em;
      line-height: 0.98;
    }

    .author-editorial__lead {
      max-width: 520px;
      margin: 21px 0 32px;
      color: var(--blue);
      font-family: var(--serif);
      font-size: clamp(1.2rem, 2vw, 1.5rem);
      line-height: 1.35;
    }

    .author-editorial__identity {
      padding: 22px 0 20px;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .author-editorial__identity h3 {
      margin: 0 0 6px;
      color: var(--navy);
      font-size: clamp(1.25rem, 2vw, 1.55rem);
      font-weight: 800;
      letter-spacing: -0.025em;
    }

    .author-editorial__identity h3 span {
      color: var(--gold-deep);
      font-size: 0.72em;
      letter-spacing: 0.04em;
    }

    .author-editorial__identity p {
      margin: 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
    }

    .author-editorial__credentials {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      margin: 28px 0 32px;
      border: 1px solid var(--line);
      background: var(--line);
    }

    .author-editorial__credential {
      min-height: 86px;
      padding: 15px 12px;
      background: var(--cream);
    }

    .author-editorial__credential strong {
      display: block;
      margin-bottom: 5px;
      color: var(--navy);
      font-size: 12px;
      letter-spacing: 0.04em;
    }

    .author-editorial__credential span {
      display: block;
      color: var(--muted);
      font-size: 10px;
      line-height: 1.45;
    }

    .author-editorial__bio {
      color: var(--muted);
      font-size: 14px;
      line-height: 1.82;
    }

    .author-editorial__bio p {
      margin: 0 0 16px;
    }

    .author-editorial__bio p:last-child {
      margin-bottom: 0;
    }

    .author-editorial__bio em {
      color: var(--navy);
      font-style: normal;
      font-weight: 700;
    }

    .author-editorial__quote {
      position: relative;
      margin: 34px 0 0;
      padding: 24px 28px 24px 64px;
      border-left: 3px solid var(--gold);
      background: var(--navy);
    }

    .author-editorial__quote-mark {
      position: absolute;
      top: 12px;
      left: 21px;
      color: var(--gold);
      font-family: var(--serif);
      font-size: 3.4rem;
      line-height: 1;
    }

    .author-editorial__quote p {
      margin: 0;
      color: rgba(255, 255, 255, 0.82);
      font-family: var(--serif);
      font-size: 1.12rem;
      line-height: 1.52;
    }

    @media (max-width: 800px) {
      .author-editorial__grid {
        grid-template-columns: 1fr;
        gap: 52px;
      }

      .author-editorial__portrait-column {
        width: min(100%, 430px);
        margin: 0 auto;
      }

      .author-editorial__content {
        max-width: none;
      }
    }

    @media (max-width: 560px) {
      .author-editorial__intro {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
      }

      .author-editorial__rule {
        width: 72px;
      }

      .author-editorial__portrait-inner {
        min-height: 390px;
      }

      .author-editorial__portrait-inner::before {
        width: 285px;
        height: 285px;
      }

      .author-editorial__portrait-inner::after {
        width: 205px;
        height: 205px;
      }

      .author-editorial__credentials {
        grid-template-columns: repeat(2, 1fr);
      }

      .author-editorial__quote {
        padding-right: 18px;
        padding-left: 50px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .author-editorial * {
        scroll-behavior: auto;
        transition: none !important;
      }
    }



    .toolkit-modal {
      position: fixed;
      inset: 0;
      z-index: 999;
      display: none;
    }

    .toolkit-modal.is-open {
      display: block;
    }

    .toolkit-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(15, 20, 40, 0.55);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .toolkit-modal-panel {
      position: relative;
      z-index: 1;
      max-width: 520px;
      margin: 8vh auto;
      background: #fff;
      border-radius: 12px;
      padding: 40px;
      max-height: 82vh;
      overflow-y: auto;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.25s ease, transform 0.25s ease;
    }

    .toolkit-modal.is-open .toolkit-modal-panel {
      opacity: 1;
      transform: translateY(0);
    }

    .toolkit-modal-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 36px;
      height: 36px;
      border: none;
      background: transparent;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
      color: #333;
    }

    .toolkit-modal-list {
      list-style: none;
      margin: 20px 0;
      padding: 0;
      display: grid;
      gap: 10px;
    }

    .toolkit-modal-list li {
      display: flex;
      align-items: baseline;
      gap: 10px;
      padding: 10px 14px;
      background: #f4f6fb;
      border-radius: 8px;
      font-size: 14px;
      color: #1a1a1a;
    }

    .toolkit-code {
      flex-shrink: 0;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.03em;
      color: #4259A9;
      background: #e8ecf7;
      padding: 3px 8px;
      border-radius: 4px;
      white-space: nowrap;
    }

    body.toolkit-modal-open {
      overflow: hidden;
    }
  </style>

  <style>
    .reveal-section {
      perspective: 1200px;
      transform-style: preserve-3d;
      will-change: opacity, transform;
      transition:
        opacity 760ms cubic-bezier(.22, 1, .36, 1),
        transform 900ms cubic-bezier(.22, 1, .36, 1);
    }

    .reveal-section.reveal-from-left {
      transform: translate3d(-72px, 0, -90px) rotateY(-7deg);
    }

    .reveal-section.reveal-from-right {
      transform: translate3d(72px, 0, -90px) rotateY(7deg);
    }

    .reveal-section.is-visible {
      opacity: 1 !important;
      transform: translate3d(0, 0, 0) rotateY(0deg);
    }

    .reveal-item {
      opacity: 0;
      transform-style: preserve-3d;
      will-change: opacity, transform;
      transition:
        opacity 680ms cubic-bezier(.22, 1, .36, 1),
        transform 760ms cubic-bezier(.22, 1, .36, 1);
    }

    .reveal-item.reveal-item-from-left {
      transform: translate3d(-46px, 18px, -50px) rotateY(-6deg);
    }

    .reveal-item.reveal-item-from-right {
      transform: translate3d(46px, 18px, -50px) rotateY(6deg);
    }

    .reveal-item.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotateY(0deg);
    }

    .reveal-section:not(.is-visible) {
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {

      .reveal-section,
      .reveal-item {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>


  <style>
    /* ACE brand palette override: #4259a9 with coordinated shades. */
    .author-editorial {
      --author-blue: #4259a9;
      --author-blue-light: #eef1fb;
      --author-blue-soft: #dfe5f7;
      --author-blue-mid: #7182c1;
      --author-blue-dark: #263875;
      --author-blue-deep: #102d4d;
      background: var(--author-blue-light);
    }

    .author-editorial__ornament {
      border-color: rgba(66, 89, 169, 0.18);
    }

    .author-editorial__ornament::after {
      border-color: rgba(66, 89, 169, 0.12);
    }

    .author-editorial__eyebrow,
    .author-editorial__caption-number {
      color: var(--author-blue-dark);
    }

    .author-editorial__rule,
    .author-editorial__portrait {
      background: var(--author-blue);
    }

    .author-editorial__portrait {
      box-shadow: 0 24px 60px rgba(16, 45, 77, 0.2);
    }

    .author-editorial__portrait::before {
      border-color: var(--author-blue-mid);
    }

    .author-editorial__portrait-inner {
      background:
        radial-gradient(circle at 50% 40%, rgba(113, 130, 193, 0.82), transparent 48%),
        linear-gradient(145deg, var(--author-blue), var(--author-blue-deep));
    }

    .author-editorial__portrait-inner::before,
    .author-editorial__portrait-inner::after {
      border-color: rgba(223, 229, 247, 0.32);
    }

    .author-editorial__initials {
      color: var(--author-blue-soft);
    }

    .author-editorial h2,
    .author-editorial__identity h3,
    .author-editorial__credential strong {
      color: var(--author-blue-deep);
    }

    .author-editorial__lead {
      color: var(--author-blue);
    }

    .author-editorial__identity {
      border-color: rgba(66, 89, 169, 0.22);
    }

    .author-editorial__identity h3 span {
      color: var(--author-blue-dark);
    }

    .author-editorial__credentials {
      border-color: rgba(66, 89, 169, 0.22);
      background: rgba(66, 89, 169, 0.22);
    }

    .author-editorial__credential {
      background: rgba(255, 255, 255, 0.72);
    }

    .author-editorial__quote {
      border-left-color: var(--author-blue-mid);
      background: var(--author-blue-dark);
    }

    .author-editorial__quote-mark {
      color: var(--author-blue-soft);
    }

    .author-editorial__quote p {
      color: #f5f7ff;
    }


    /* --- EXACT BRAND COLOR (#4259A9) LUXURY STYLING --- */
    .workbook-luxury-elite {
      background: linear-gradient(180deg, #f8faff 0%, #edf2fd 100%);
      color: #1e293b;
      padding: 110px 0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .workbook-luxury-elite .shell {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .workbook-luxury-elite .section-heading {
      text-align: center;
      margin-bottom: 75px;
    }

    .workbook-luxury-elite .eyebrow {
      display: inline-block;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      font-size: 0.75rem;
      font-weight: 800;
      color: #4259A9;
      margin-bottom: 1rem;
      padding: 6px 16px;
      background: rgba(66, 89, 169, 0.08);
      border-radius: 50px;
    }

    .workbook-luxury-elite h2 {
      font-size: 2.75rem;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 1.25rem;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .workbook-luxury-elite h2 em {
      color: #4259A9;
      font-style: italic;
    }

    .workbook-luxury-elite .section-heading p {
      color: #475569;
      font-size: 1.15rem;
      max-width: 680px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* Base Grid (Default 3 Columns for Workbook) */
    .elite-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem 2rem;
      align-items: stretch;
    }

    /* Modifier for 4-Column Layout (For Benefits) */
    .elite-grid.grid-4-cols {
      grid-template-columns: repeat(4, 1fr);
    }

    /* Mobile Responsiveness (ALWAYS put this at the bottom) */
    @media (max-width: 1024px) {

      .elite-grid,
      .elite-grid.grid-4-cols {
        grid-template-columns: 1fr !important;
      }
    }

    .elite-column {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* Increase width specifically for the Benefits section */
    #benefits-actual .shell {
      max-width: 1320px !important;
    }



    /* Luxurious Card Design */
    .icon-card-elite {
      background: #ffffff;
      border: 1px solid rgba(66, 89, 169, 0.12);
      border-radius: 24px;
      padding: 3rem 2rem;
      display: flex;
      flex-direction: column;
      /* Stack icon and text vertically */
      align-items: center;
      /* Center everything horizontally */
      text-align: center;
      /* Center the text inside h3 and p */
      gap: 1.5rem;
      min-height: 120px;
      /* Adjust this value until the tallest card fits */
      height: 100%;
      box-shadow: 0 10px 30px -10px rgba(66, 89, 169, 0.06);
      transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .icon-card-elite::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: #4259A9;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .icon-card-elite:hover {
      transform: translateY(-5px);
      border-color: #4259A9;
      box-shadow: 0 20px 40px -12px rgba(66, 89, 169, 0.18);
    }

    .icon-card-elite:hover::before {
      opacity: 1;
    }

    .icon-badge-elite {
      margin-top: 0;
      /* Reset any previous offsets */
      flex-shrink: 0;
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, rgba(66, 89, 169, 0.1) 0%, rgba(66, 89, 169, 0.04) 100%);
      border: 1px solid rgba(66, 89, 169, 0.2);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #4259A9;
      transition: all 0.3s ease;
    }

    .icon-card-elite:hover .icon-badge-elite {
      background: #4259A9;
      color: #ffffff;
      transform: scale(1.08) rotate(3deg);
    }

    .icon-badge-elite svg {
      width: 24px;
      height: 24px;
    }

    .icon-card-elite h3 {
      font-size: 1.25rem;
      font-weight: 700;
      color: #0f172a;
      margin: 0.75rem;
      max-width: 280px;
      /* Prevents titles from getting too wide */
      line-height: 1.4;
    }

    .icon-card-elite p {
      font-size: 1rem;
      color: #475569;
      line-height: 1.6;
      max-width: 320px;
      /* Keeps the text block narrow and elegant */
      margin: 0 auto;
      /* Ensures the block itself is centered */
    }



    /* 13th Item Featured Spotlight to Eliminate Empty Space */
    .spotlight-card-elite {
      grid-column: 1 / -1;
      background:
        radial-gradient(circle at 82% 22%, rgba(66, 89, 169, 0.34), transparent 26rem),
        linear-gradient(135deg, #0c1d35 0%, #102d4d 55%, #162c68 100%);
      color: #ffffff;
      border: none;
      padding: 2rem 2.5rem;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 20px 40px rgba(16, 45, 77, 0.22);
      margin-top: 1rem;
    }

    .spotlight-card-elite .icon-badge-elite {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      width: 60px;
      height: 60px;
      border-radius: 16px;
      margin-top: 5px;
    }

    .spotlight-card-elite h3 {
      color: #ffffff;
      font-size: 1.35rem;
      margin: 0;
    }

    .spotlight-content {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
    }

    /* Keep the audience cards as a deliberate, centered composition. */
    #audience-actual .elite-grid {
      width: 100%;
      max-width: 840px;
      margin-inline: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }

    #audience-actual .elite-column {
      min-width: 0;
      gap: 1.5rem;
    }

    #audience-actual .icon-card-elite {
      min-height: 230px;
    }

    @media (max-width: 1024px) {
      #audience-actual .elite-grid {
        max-width: 760px;
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      }
    }

    @media (max-width: 768px) {
      #audience-actual .elite-grid {
        max-width: 380px;
        grid-template-columns: 1fr !important;
      }

      .spotlight-card-elite {
        flex-direction: column;
        text-align: center;
        gap: 1.5rem;
      }

      .spotlight-content {
        flex-direction: column;
      }

      .workbook-luxury-elite h2 {
        font-size: 2.1rem;
      }
    }

    .consent-check {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      cursor: pointer;
      width: auto;
    }

    .consent-check input[type="checkbox"] {
      appearance: auto;
      /* reset any custom/button-like styling */
      -webkit-appearance: auto;
      width: 16px;
      height: 16px;
      flex: 0 0 16px;
      /* stop it growing to fill the row */
      margin: 3px 0 0 0;
      /* small top margin to align with first line of text */
      padding: 0;
    }

    .consent-check span {
      flex: 1;
    }
  </style>



</head>

<body class="dpia-site" data-footer-context="ebook">
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <div class="topbar">
    <div class="shell topbar-inner">
      <span class="topbar-note">
        <bold>. LAUNCHING SOON</bold>
      </span>
    </div>
  </div>

  <header class="site-header" data-header>
    <div class="shell nav-wrap">
      <a class="brand" href="../" aria-label="ACE Data Protection Consulting home">
        <img src="../images/logo.png" alt="ACE Data Protection Consulting" width="156" height="70" fetchpriority="high">
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span></span><span></span><span></span>
        <span class="sr-only">Open navigation menu</span>
      </button>
      <a class="mobile-priority-cta" href="#priority-actual">Join priority list <span aria-hidden="true">→</span></a>
      <nav class="site-menu" id="site-menu" aria-label="Main navigation" data-menu>
        <a href="#hero-actual">Learn</a>
        <a href="#toolkit-actual">Implement</a>
        <a href="#training-actual">Build Capability</a>
        <a href="#consultation-actual">Get Support</a>
        <a class="nav-cta" href="#priority-actual">Join priority list <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>

  <main id="main-content">

    <!-- START OF HERO CONTAINER -->
    <div id="hero-master-wrapper" style="position: relative;">

      <!-- [PASTE SKELETON CODE HERE] -->
      <div id="hero-skeleton" class="hero-skeleton-wrapper">
        <div class="shell hero-inner" style="display: flex; gap: 60px; align-items: center;">
          <div class="hero-copy" style="flex: 1;">
            <div class="skel-shimmer skel-eyebrow"></div>
            <div class="skel-shimmer skel-title"></div>
            <div class="skel-shimmer skel-subtitle"></div>
            <div class="skel-shimmer skel-desc"></div>
            <div class="skel-shimmer skel-desc" style="width: 80%;"></div>
            <div class="hero-actions" style="margin-top: 40px;">
              <div class="skel-shimmer skel-btn"></div>
              <div class="skel-shimmer skel-btn"></div>
            </div>
          </div>
          <div class="hero-art" style="flex: 1; text-align: center;">
            <div class="skel-shimmer skel-book"></div>
          </div>
        </div>
      </div>

      <section id="hero-actual" class="hero section-dark reveal-section reveal-from-left"
        style="display: none; opacity: 0;" aria-labelledby="hero-title">
        <div class="hero-photo" aria-hidden="true"></div>
        <div class="hero-grid-lines" aria-hidden="true"></div>

        <svg class="ace-ebook-spotlight" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 3787 2842" fill="none">
          <g filter="url(#ace-ebook-spotlight-filter )">
            <ellipse cx="1924.71" cy="273.501" rx="1924.71" ry="273.501"
              transform="matrix(-0.822377 -0.568943 -0.568943 0.822377 3631.88 2291.09)" fill="#4259A9"
              fill-opacity="0.28" />
          </g>

          <defs>
            <filter id="ace-ebook-spotlight-filter" x="0.860352" y="0.838989" width="3785.16" height="2840.26"
              filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
              <feFlood flood-opacity="0" result="BackgroundImageFix" />
              <feBlend mode="normal" in="SourceGraphic" in2="BackgroundImageFix" result="shape" />
              <feGaussianBlur stdDeviation="151" result="effect1_foregroundBlur" />
            </filter>
          </defs>
        </svg>

        <div class="ebook-hero-orbs" aria-hidden="true">
          <span class="ebook-orb ebook-orb-1"></span>
          <span class="ebook-orb ebook-orb-2"></span>
          <span class="ebook-orb ebook-orb-3"></span>
          <span class="ebook-orb ebook-orb-4"></span>
          <span class="ebook-orb ebook-orb-5"></span>
          <span class="ebook-orb ebook-orb-6"></span>
          <span class="ebook-orb ebook-orb-7"></span>
        </div>


        <div class="shell hero-inner">
          <div class="hero-copy">
            <p class="eyebrow hero-eyebrow" style="color: var(--gold); font-size: medium;"><span class="journey-step"
                aria-hidden="true">01</span><span class="eyebrow-rule" aria-hidden="true"></span>
              LEARN</p>
            <h1 id="hero-title">
              DPIA Made Easy
              <em>– <span class="hero-title-highlight">Professional Edition</span></em>
            </h1>
            <p class="hero-subtitle">Handbook &amp; workbook only</p>
            <div class="hero-offer" aria-labelledby="hero-offer-title">
              <p class="hero-offer-title" id="hero-offer-title">Includes:</p>
              <ul class="hero-offer-list">
                <li>DPIA Made Easy – Professional Edition</li>
                <li>Practical Handbook, Workbook</li>
                <li>Available in Digital/PDF edition and Print Edition</li>
              </ul>
            </div>
            <p class="hero-description"><strong>Ideal for:</strong> DPOs, privacy professionals, compliance teams, legal
              professionals, risk teams, project managers and organisations looking to understand and implement DPIAs.
            </p>
            <div class="hero-actions">
              <div class="hero-format-control">
                <label for="handbook-format">Select Format</label>
                <select id="handbook-format" name="handbook_format" required>
                  <option value="" selected disabled>Select Format</option>
                  <option value="digital-pdf">Digital/PDF Edition</option>
                  <option value="print">Print Edition</option>
                </select>
              </div>
              <a class="button button-white" href="./toolkit/#purchase" data-handbook-cta>Buy Handbook <span
                  aria-hidden="true">↗</span></a>
            </div>
            <p class="hero-format-status" data-handbook-format-status role="status" hidden>Please select a format to
              continue.</p>
          </div>
          <div class="hero-art" aria-label="DPIA Made Easy Professional Edition book cover">
            <div class="book-glow" aria-hidden="true"></div>
            <div class="book-shadow" aria-hidden="true"></div>
            <div class="book-card book-card-back" aria-hidden="true"></div>
            <div class="book-card book-card-spine" aria-hidden="true"></div>
            <img class="book-cover" src="../images/dpia-book-front.png"
              alt="DPIA Made Easy: Data Privacy Impact Assessments, Professional Workbook Edition book cover"
              width="381" height="666">
            <div class="art-caption">
              <span class="caption-line"></span>
              <span>
                Knowledge that

                moves from regulation to action.
              </span>
            </div>
          </div>
        </div>
        <div class="hero-wave" aria-hidden="true"></div>
      </section>
    </div>

    <!-- MASTER INTRO WRAPPER -->
    <div id="intro-master-wrapper" style="position: relative;">

      <!-- 1. SKELETON STATE -->
      <div id="intro-skeleton" class="skel-intro-wrapper">
        <div class="shell intro-grid" style="display: flex; gap: 40px;">

